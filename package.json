{
  "name": "dsh-super-agent",
  "version": "0.13.0",
  "private": true,
  "description": "DSH plugin: independent agent chats, primary coordination, durable task handoffs and scoped group collaboration on one Router/Worker runtime.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./protocol": "./lib/protocol.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.1"
  },
  "files": [
    "lib",
    "bin",
    "docs/*.md",
    "docs/images",
    "docs/preview.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:core": "node bin/check.mjs",
    "test:core": "node --test test/*.test.mjs",
    "test": "npm run test:core"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "super-agent",
    "superagent",
    "router",
    "worker",
    "event-driven",
    "watchdog"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "bin": {
    "super-agent": "./bin/super-agent.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TianzeLuo/dsh-super-agent.git"
  }
}
